ENV=development

# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI)
# Use the "Session pooler" connection (IPv4-safe, free) for a persistent backend like this one.
# IMPORTANT: percent-encode special characters in the password (@ -> %40, # -> %23, etc.)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-ENCODED-PASSWORD]@[pooler-host]:5432/postgres

# Supabase project (Settings -> API)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Upstash Redis REST API (Console -> your DB -> REST API section).
# Blank = rate limiting + read cache both fail open (no-op), never an error.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# S3-compatible object storage for the independent nightly backup (Doc 03
# sec 8/9) - Cloudflare R2 or Backblaze B2, your choice; both expose an
# S3-compatible API so only the endpoint URL below differs.
#   R2: https://<account_id>.r2.cloudflarestorage.com
#   B2: https://s3.<region>.backblazeb2.com
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=

# Razorpay (Dashboard -> Settings -> API Keys; test mode first - never
# live billing without explicit go-live). Webhook secret is set separately
# under Settings -> Webhooks when you register the /payments/webhook URL.
# Blank = payments routes fail closed (503), never a silent no-op.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (resend.com/api-keys). Requires a verified sending domain with
# SPF/DKIM/DMARC records added at your DNS provider first - see Resend's
# dashboard for the exact records to add. Blank = the notification worker
# logs + records a 'failed' row per skipped send instead of silently
# no-oping.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Pricing-page waitlist notification target (Doc handoffs/
# PHASE-2.5-HANDOFF.md sec 3.7). Blank = signups still succeed for the
# visitor, just logged instead of emailed.
WAITLIST_NOTIFY_EMAIL=
