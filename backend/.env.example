ENV=development

# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI)
# Use the "Session pooler" or direct connection string; psycopg driver:
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# Supabase project (Settings -> API)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
