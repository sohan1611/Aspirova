ENV=development

# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI)
# Use the "Session pooler" connection (IPv4-safe, free) for a persistent backend like this one.
# IMPORTANT: percent-encode special characters in the password (@ -> %40, # -> %23, etc.)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-ENCODED-PASSWORD]@[pooler-host]:5432/postgres

# Supabase project (Settings -> API)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
